@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
    var email = User.FindFirst(AdminAuthenticationDefaults.EmailClaim)?.Value ?? L["Layout_AdminFallback"].Value;
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var pageTitle = ViewData["Title"]?.ToString() ?? L["Page_Dashboard"].Value;
    var isDashboard = path == "/admin";
    var isIdentities = path.StartsWith("/admin/identities", StringComparison.Ordinal);
    var isShop = path.StartsWith("/admin/shop", StringComparison.Ordinal);
    var isCatalog = path == "/admin/catalog";
    var isAutomation = path.StartsWith("/admin/automation", StringComparison.Ordinal);
    var isIntegrations = path.StartsWith("/admin/integrations", StringComparison.Ordinal);
    var isOverlay = path.StartsWith("/admin/overlay", StringComparison.Ordinal);
    var isAudit = path.StartsWith("/admin/audit", StringComparison.Ordinal);
    var isAccount = path.StartsWith("/admin/account", StringComparison.Ordinal);
}
<!doctype html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["Layout_PageTitle", pageTitle]</title>
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
</head>
<body class="admin-shell">
    <a class="skip-link" href="#main-content">@L["Layout_SkipToContent"]</a>
    <div class="admin-frame">
        <aside id="admin-navigation-drawer" class="sidebar" aria-label="@L["Layout_Administration"]">
            <a class="brand" href="/admin">
                <span class="brand-mark" aria-hidden="true">F</span>
                <span><strong>FlurNetz</strong><small>@L["Brand_AdminSubtitle"]</small></span>
            </a>
            <nav class="nav-groups" aria-label="@L["Layout_MainNavigation"]">
                <div class="nav-group" role="group" aria-labelledby="nav-overview-label">
                    <span id="nav-overview-label" class="nav-label">@L["Layout_Overview"]</span>
                    <a class="nav-link @(isDashboard ? "active" : "")" data-admin-nav-link data-nav-key="dashboard" href="/admin" @if (isDashboard) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">⌂</span><span class="nav-link-label">@L["Nav_Dashboard"]</span></a>
                    <a class="nav-link @(isIdentities ? "active" : "")" data-admin-nav-link data-nav-key="identities" href="/admin/identities" @if (isIdentities) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">◎</span><span class="nav-link-label">@L["Nav_Identities"]</span></a>
                </div>
                <div class="nav-group" role="group" aria-labelledby="nav-content-label">
                    <span id="nav-content-label" class="nav-label">@L["Layout_Content"]</span>
                    <a class="nav-link @(isShop ? "active" : "")" data-admin-nav-link data-nav-key="shop" href="/admin/shop" @if (isShop) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">▣</span><span class="nav-link-label">@L["Nav_Shop"]</span></a>
                    <a class="nav-link @(isCatalog ? "active" : "")" data-admin-nav-link data-nav-key="catalog" href="/admin/catalog" @if (isCatalog) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">✦</span><span class="nav-link-label">@L["Nav_AchievementsTitles"]</span></a>
                    <a class="nav-link" data-admin-nav-link data-nav-key="rewards" data-nav-fragment="rewards" href="/admin/catalog#rewards"><span class="nav-icon" aria-hidden="true">◈</span><span class="nav-link-label">@L["Nav_Rewards"]</span></a>
                </div>
                <div class="nav-group" role="group" aria-labelledby="nav-system-label">
                    <span id="nav-system-label" class="nav-label">@L["Layout_System"]</span>
                    <a class="nav-link @(isAutomation ? "active" : "")" data-admin-nav-link data-nav-key="automation" href="/admin/automation" @if (isAutomation) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">↗</span><span class="nav-link-label">@L["Nav_Automation"]</span></a>
                    <a class="nav-link @(isIntegrations ? "active" : "")" data-admin-nav-link data-nav-key="integrations" href="/admin/integrations" @if (isIntegrations) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">⌁</span><span class="nav-link-label">@L["Nav_Integrations"]</span></a>
                    <a class="nav-link @(isOverlay ? "active" : "")" data-admin-nav-link data-nav-key="overlay" href="/admin/overlay" @if (isOverlay) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">◌</span><span class="nav-link-label">@L["Nav_Overlay"]</span></a>
                </div>
                <div class="nav-group" role="group" aria-labelledby="nav-administration-label">
                    <span id="nav-administration-label" class="nav-label">@L["Layout_AdministrationGroup"]</span>
                    <a class="nav-link @(isAudit ? "active" : "")" data-admin-nav-link data-nav-key="audit" href="/admin/audit" @if (isAudit) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">▤</span><span class="nav-link-label">@L["Nav_Audit"]</span></a>
                    <a class="nav-link @(isAccount ? "active" : "")" data-admin-nav-link data-nav-key="account" href="/admin/account" @if (isAccount) { <text>aria-current="page"</text> }><span class="nav-icon" aria-hidden="true">⚙</span><span class="nav-link-label">@L["Nav_Account"]</span></a>
                </div>
            </nav>
            <div class="sidebar-footer">
                <div class="user-chip"><span class="avatar">@email[..Math.Min(1, email.Length)]</span><span><strong>@email</strong><small>@L["Layout_AdminRole"]</small></span></div>
                <form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button class="logout-button" type="submit">@L["Nav_Logout"]</button></form>
            </div>
        </aside>
        <main id="main-content" class="main-content" tabindex="-1">
            <header class="mobile-topbar" aria-label="@L["Layout_Administration"]">
                <button class="mobile-nav-toggle secondary-button" type="button" data-nav-toggle data-nav-label-open="@L["Nav_MenuOpen"]" data-nav-label-close="@L["Nav_MenuClose"]" aria-controls="admin-navigation-drawer" aria-expanded="false" aria-label="@L["Nav_MenuOpen"]">
                    <span class="nav-toggle-icon" aria-hidden="true"></span><span>@L["Nav_Menu"]</span>
                </button>
                <a class="brand" href="/admin">
                    <span class="brand-mark" aria-hidden="true">F</span>
                    <span><strong>FlurNetz</strong><small>@L["Brand_AdminSubtitle"]</small></span>
                </a>
            </header>
            <div class="page-content" data-nav-main>
                @RenderBody()
            </div>
        </main>
        <button class="nav-scrim" type="button" data-nav-close aria-label="@L["Nav_Close"]" hidden></button>
    </div>
    <script src="~/admin/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
