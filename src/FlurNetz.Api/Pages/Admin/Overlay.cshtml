@page "/admin/overlay"
@model FlurNetz.Api.Pages.Admin.OverlayModel
@{ ViewData["Title"] = "Overlay"; }
<header class="page-header"><div><div class="eyebrow">System</div><h1>Overlay</h1><p class="muted">Channels, Status und sichere One-Time-Source-Key-Aktionen.</p></div></header>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">Channels</div><h2>Browser Sources</h2></div><span class="badge">@Model.Items.Count</span></div>@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> } else if (Model.Items.Count == 0) { <div class="empty-state"><strong>Keine Overlay-Channels</strong><p>Es wurden noch keine Channels angelegt.</p></div> } else { <div class="table-wrap"><table><caption class="visually-hidden">Overlay-Channels</caption><thead><tr><th>Name</th><th>Status</th><th>Aktualisiert</th><th>ID</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.DisplayName</strong><small>@item.Description</small></td><td><span class="badge">@(item.IsArchived ? "Archiviert" : item.IsEnabled ? "Aktiv" : "Deaktiviert")</span></td><td>@item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><code>@item.Id.Value</code></td></tr> }</tbody></table></div> }</section>
