@page "/admin/account"
@model FlurNetz.Api.Pages.Admin.AccountModel
@{
    ViewData["Title"] = "Account";
}
<header class="page-header"><div><div class="eyebrow">Administration</div><h1>Account</h1><p class="muted">Ändere dein Admin-Passwort. Alle älteren Sessions werden dabei ungültig.</p></div></header>
@if (Model.Success) { <div class="notice success" role="status">Passwort geändert. Die übrigen Sessions wurden beendet.</div> }
<section class="panel form-panel"><div class="eyebrow">Credential Security</div><h2>Passwort ändern</h2><p class="muted">Verwende eine lange Passphrase mit mindestens 15 Zeichen. Das Passwort wird nie im Klartext gespeichert.</p><form method="post" class="stack-form narrow-form" autocomplete="off" data-password-generator>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div><label asp-for="CurrentPassword">Aktuelles Passwort</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="field-error"></span><label asp-for="NewPassword">Neues Passwort</label><div class="password-input-row"><input asp-for="NewPassword" type="password" autocomplete="new-password" data-password-generator-password /><button class="secondary-button password-toggle-button" type="button" data-password-toggle aria-controls="NewPassword NewPasswordConfirmation" aria-pressed="false">Anzeigen</button></div><span asp-validation-for="NewPassword" class="field-error"></span><div class="password-actions"><button class="secondary-button" type="button" data-password-generate>Sicheres Passwort generieren</button><button class="secondary-button" type="button" data-password-copy disabled>Kopieren</button></div><p class="form-help">Der Generator läuft nur in diesem Browser. Speichere das Passwort jetzt sicher; es wird nicht in Browser-Speichern, Cookies, Logs oder Auditdaten abgelegt.</p><label asp-for="NewPasswordConfirmation">Neues Passwort bestätigen</label><input asp-for="NewPasswordConfirmation" type="password" autocomplete="new-password" data-password-generator-confirm /><span asp-validation-for="NewPasswordConfirmation" class="field-error"></span><p class="form-status" data-password-status role="status" aria-live="polite"></p><button class="primary-button" type="submit">Passwort sicher ändern</button></form></section>
@section Scripts { <script src="~/admin/admin.js" asp-append-version="true"></script> }
