@page "/admin/account"
@model FlurNetz.Api.Pages.Admin.AccountModel
@{
    ViewData["Title"] = L["Page_Account"].Value;
}
<header class="page-header">
    <div>
        <div class="eyebrow">@L["Account_Eyebrow"]</div>
        <h1>@L["Page_Account"]</h1>
        <p class="muted">@L["Account_Description"]</p>
    </div>
</header>
@if (Model.Success)
{
    <div class="notice success" role="status">@L["Account_Success"]</div>
}
<section class="panel form-panel" aria-labelledby="language-title">
    <div class="eyebrow">@L["Account_Preferences"]</div>
    <h2 id="language-title">@L["Account_Language"]</h2>
    <p class="muted">@L["Account_LanguageHelp"]</p>
    @if (Model.LanguageSuccess)
    {
        <div class="notice success" role="status">@L["Account_LanguageSaved"]</div>
    }
    <form method="post" asp-page-handler="Language" class="stack-form language-preference-form">
        @Html.AntiForgeryToken()
        <label asp-for="PreferredCulture">@L["Account_Language"]</label>
        <select asp-for="PreferredCulture">
            <option value="de">@L["Account_LanguageGerman"]</option>
            <option value="en">@L["Account_LanguageEnglish"]</option>
        </select>
        <span asp-validation-for="PreferredCulture" class="field-error"></span>
        <button class="primary-button" type="submit">@L["Account_LanguageSave"]</button>
    </form>
</section>
<section class="panel form-panel" aria-labelledby="password-title">
    <div class="eyebrow">@L["Account_Security"]</div>
    <h2 id="password-title">@L["Account_ChangePassword"]</h2>
    <p class="muted">@L["Account_PasswordHelp"]</p>
    <form method="post" class="stack-form narrow-form" autocomplete="off" data-password-generator>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
        <label asp-for="CurrentPassword">@L["Account_CurrentPassword"]</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
        <label asp-for="NewPassword">@L["Account_NewPassword"]</label>
        <div class="password-input-row">
            <input asp-for="NewPassword" type="password" autocomplete="new-password" data-password-generator-password />
            <button class="secondary-button password-toggle-button" type="button" data-password-toggle data-show-label="@L["Account_Show"]" data-hide-label="@L["Account_Hide"]" aria-controls="NewPassword NewPasswordConfirmation" aria-pressed="false">@L["Account_Show"]</button>
        </div>
        <span asp-validation-for="NewPassword" class="field-error"></span>
        <div class="password-actions">
            <button class="secondary-button" type="button" data-password-generate data-generated-message="@L["Account_Generated"]" data-generation-error="@L["Account_GenerationError"]">@L["Account_Generate"]</button>
            <button class="secondary-button" type="button" data-password-copy data-copy-unavailable="@L["Account_CopyUnavailable"]" data-copy-success="@L["Account_Copied"]" data-copy-denied="@L["Account_CopyDenied"]" disabled>@L["Account_Copy"]</button>
        </div>
        <p class="form-help">@L["Account_PasswordHelpShort"]</p>
        <label asp-for="NewPasswordConfirmation">@L["Account_ConfirmPassword"]</label>
        <input asp-for="NewPasswordConfirmation" type="password" autocomplete="new-password" data-password-generator-confirm />
        <span asp-validation-for="NewPasswordConfirmation" class="field-error"></span>
        <p class="form-status" data-password-status role="status" aria-live="polite"></p>
        <button class="primary-button" type="submit">@L["Account_Submit"]</button>
    </form>
</section>
