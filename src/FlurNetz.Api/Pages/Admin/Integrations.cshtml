@page "/admin/integrations"
@model FlurNetz.Api.Pages.Admin.IntegrationsModel
@{ ViewData["Title"] = "Integrations"; }
<header class="page-header"><div><div class="eyebrow">System</div><h1>Integrations</h1><p class="muted">Ausschließlich externe Identity-Mappings; keine OAuth- oder Tokenverwaltung.</p></div></header>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">External Identity</div><h2>Mappings</h2></div><span class="badge">@Model.Items.Count</span></div>@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> } else if (Model.Items.Count == 0) { <div class="empty-state"><strong>Keine Mappings</strong><p>Es sind keine externen Identitätsverknüpfungen vorhanden.</p></div> } else { <div class="table-wrap"><table><caption class="visually-hidden">External Identity Mappings</caption><thead><tr><th>Provider</th><th>ExternalUserId</th><th>CommunityIdentityId</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.ProviderKey.Value</td><td>@item.ExternalUserId.Value</td><td><a class="id-link" href="/admin/identities/@item.CommunityIdentityId.Value:D">@item.CommunityIdentityId.Value</a></td></tr> }</tbody></table></div> }</section>
