@page "/admin/integrations"
@model FlurNetz.Api.Pages.Admin.IntegrationsModel
@{
    ViewData["Title"] = L["Page_Integrations"].Value;
}
<header class="page-header">
    <div>
        <div class="eyebrow">@L["Layout_System"]</div>
        <h1>@L["Page_Integrations"]</h1>
        <p class="muted">@L["Integrations_Description"]</p>
    </div>
</header>
<section class="panel" aria-labelledby="mappings-title">
    <div class="panel-heading"><div><div class="eyebrow">@L["Integrations_Mappings"]</div><h2 id="mappings-title">@L["Integrations_Mappings"]</h2></div><span class="badge">@Model.Items.Count.ToString("N0", CultureInfo.CurrentCulture)</span></div>
    @if (Model.Error is not null)
    {
        <div class="notice error" role="alert">@Model.Error</div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="empty-state"><span class="empty-icon" aria-hidden="true">⌁</span><strong>@L["Integrations_Empty"]</strong><p>@L["Integrations_EmptyHelp"]</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <caption class="visually-hidden">@L["Integrations_TableCaption"]</caption>
                <thead><tr><th scope="col">@L["Integrations_ColumnProvider"]</th><th scope="col">@L["Integrations_ColumnExternalId"]</th><th scope="col">@L["Integrations_ColumnCommunityId"]</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    var communityIdentityId = item.CommunityIdentityId.Value.ToString("D");
                    <tr><td><strong>@item.ProviderKey.Value</strong></td><td><code>@item.ExternalUserId.Value</code></td><td><a class="id-link" href="/admin/identities/@communityIdentityId">@communityIdentityId</a></td></tr>
                }
                </tbody>
            </table>
        </div>
        <p class="panel-footnote">@L["Integrations_ReadOnlyNote"]</p>
    }
</section>
