@page "/admin/forbidden"
@model FlurNetz.Api.Pages.Admin.ForbiddenModel
@{
    Layout = null;
    ViewData["Title"] = L["Page_Forbidden"].Value;
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = $"{Request.PathBase}{Request.Path}";
}
<!doctype html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["Page_Forbidden"] – FlurNetz</title>
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-card" aria-labelledby="forbidden-title">
        <div class="eyebrow">403</div>
        <h1 id="forbidden-title">@L["Page_Forbidden"]</h1>
        <p class="muted">@L["Forbidden_Description"]</p>
        <a class="primary-button button-link" href="/admin">@L["Forbidden_Back"]</a>
        <form class="login-language-switcher" method="get" action="/admin/culture">
            <label for="forbidden-language">@L["Language_Label"]</label>
            <div class="language-control">
                <select id="forbidden-language" name="culture" aria-label="@L["Language_Label"]">
                    @if (culture == "de") { <option value="de" selected>@L["Language_German"]</option> } else { <option value="de">@L["Language_German"]</option> }
                    @if (culture == "en") { <option value="en" selected>@L["Language_English"]</option> } else { <option value="en">@L["Language_English"]</option> }
                </select>
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button class="secondary-button" type="submit">@L["Language_Apply"]</button>
            </div>
        </form>
    </main>
</body>
</html>
