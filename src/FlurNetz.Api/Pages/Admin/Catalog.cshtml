@page "/admin/catalog"
@model FlurNetz.Api.Pages.Admin.CatalogModel
@{ ViewData["Title"] = "Inhalte"; }
<header class="page-header"><div><div class="eyebrow">Inhalte</div><h1>Definitionen &amp; Rewards</h1><p class="muted">Owner-owned Kataloge, ohne künstliche Aktivierungs- oder Delete-Semantik.</p></div></header>
@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> }
<section class="detail-grid"><article class="panel"><div class="panel-heading"><h2>Achievements</h2><span class="badge">@Model.AchievementDefinitions.Count</span></div>@if (Model.AchievementDefinitions.Count == 0) { <div class="empty-inline">Keine Definitionen.</div> } else { foreach (var item in Model.AchievementDefinitions) { <div class="key-value"><span>@item.DisplayName</span><code>@item.Id.Value</code></div> } }</article><article class="panel"><div class="panel-heading"><h2>Titles</h2><span class="badge">@Model.TitleDefinitions.Count</span></div>@if (Model.TitleDefinitions.Count == 0) { <div class="empty-inline">Keine Definitionen.</div> } else { foreach (var item in Model.TitleDefinitions) { <div class="key-value"><span>@item.DisplayName</span><code>@item.Id.Value</code></div> } }</article><article class="panel"><div class="panel-heading"><h2>Reward Definitions</h2><span class="badge">@Model.RewardDefinitions.Count</span></div>@if (Model.RewardDefinitions.Count == 0) { <div class="empty-inline">Keine Definitionen.</div> } else { foreach (var item in Model.RewardDefinitions) { if (item is FlurNetz.Modules.Rewards.Domain.EconomyBalanceRewardDefinition economy) { <div class="key-value"><span>Economy Balance</span><strong>@economy.Amount</strong></div> } } }</article><article class="panel"><div class="panel-heading"><h2>Packages</h2><span class="badge">@Model.RewardPackages.Count</span></div>@if (Model.RewardPackages.Count == 0) { <div class="empty-inline">Keine Packages.</div> } else { foreach (var item in Model.RewardPackages) { <div class="key-value"><code>@item.Id.Value</code><strong>@item.RewardDefinitionIds.Count Definitions</strong></div> } }</article></section>
