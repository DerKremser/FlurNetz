@page "/admin/audit"
@model FlurNetz.Api.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Audit";
}
<header class="page-header"><div><div class="eyebrow">Nachvollziehbarkeit</div><h1>Audit</h1><p class="muted">Append-only Verlauf der administrativen Aktionen.</p></div></header>
<section class="panel"><div class="filter-bar"><span class="muted">@Model.Entries.Count Einträge geladen</span><span class="badge neutral">Append-only</span></div>@if (Model.Error is not null) { <div class="notice error">@Model.Error</div> } else if (Model.Entries.Count == 0) { <div class="empty-state"><span class="empty-icon">▤</span><strong>Noch kein Verlauf</strong><p>Audit-Einträge werden erst nach erfolgreichen Admin-Aktionen sichtbar.</p></div> } else { <div class="table-wrap"><table><caption class="visually-hidden">Administration Audit</caption><thead><tr><th>Aktion</th><th>Ziel</th><th>Risiko</th><th>Ergebnis</th><th>Zeitpunkt</th></tr></thead><tbody>@foreach (var entry in Model.Entries) { <tr><td><strong>@entry.Action</strong><small class="table-subtext">@entry.ActorLoginNameSnapshot</small></td><td>@entry.TargetType<br /><small class="table-subtext">@entry.TargetId</small></td><td><span class="badge @(entry.RiskLevel == FlurNetz.Modules.Administration.Contracts.Audit.AdminRiskLevel.High ? "danger" : "neutral")">@entry.RiskLevel</span></td><td><span class="badge">@entry.Result</span></td><td>@entry.OccurredAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td></tr>}</tbody></table></div> }</section>
