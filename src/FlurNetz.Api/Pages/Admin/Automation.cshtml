@page "/admin/automation"
@model FlurNetz.Api.Pages.Admin.AutomationModel
@{ ViewData["Title"] = "Automation"; }
<header class="page-header"><div><div class="eyebrow">System</div><h1>Automation</h1><p class="muted">Rules und ihre Ausführungsverläufe – ohne Run-Now oder Replay.</p></div></header>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">Owner</div><h2>Rules</h2></div><span class="badge">@Model.Items.Count</span></div>@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> } else if (Model.Items.Count == 0) { <div class="empty-state"><strong>Keine Rules</strong><p>Es sind noch keine Automation-Rules vorhanden.</p></div> } else { <div class="table-wrap"><table><caption class="visually-hidden">Automation-Rules</caption><thead><tr><th>Name</th><th>Trigger</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.DisplayName</strong><small>@item.Description</small></td><td>@item.TriggerType</td><td><span class="badge">@(item.IsArchived ? "Archiviert" : item.IsEnabled ? "Aktiv" : "Deaktiviert")</span></td><td>@item.Actions.Count</td></tr> }</tbody></table></div> }</section>
