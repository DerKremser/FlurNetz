@page "/admin/setup"
@model FlurNetz.Api.Pages.Admin.SetupModel
@{
    Layout = null;
    ViewData["Title"] = "Ersteinrichtung";
}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ersteinrichtung – FlurNetz</title>
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-card" aria-labelledby="setup-title">
        <div class="brand login-brand"><span class="brand-mark">F</span><span><strong>FlurNetz</strong><small>Administration</small></span></div>
        <div class="eyebrow">Einmalige Ersteinrichtung</div>
        <h1 id="setup-title">Administrator einrichten</h1>
        <p class="muted">Lege den ersten Administrator mit einer E-Mail-Adresse und einem sicheren Passwort an. Dieser Flow ist danach dauerhaft geschlossen.</p>
        <form method="post" class="stack-form" autocomplete="off" data-password-generator>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <label asp-for="Email">E-Mail-Adresse</label>
            <input asp-for="Email" type="email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
            <label asp-for="NewPassword">Passwort</label>
            <div class="password-input-row"><input asp-for="NewPassword" type="password" autocomplete="new-password" data-password-generator-password /><button class="secondary-button password-toggle-button" type="button" data-password-toggle aria-controls="NewPassword NewPasswordConfirmation" aria-pressed="false">Anzeigen</button></div>
            <span asp-validation-for="NewPassword" class="field-error"></span>
            <div class="password-actions"><button class="secondary-button" type="button" data-password-generate>Sicheres Passwort generieren</button><button class="secondary-button" type="button" data-password-copy disabled>Kopieren</button></div>
            <p class="form-help">Der Generator läuft nur in diesem Browser. Speichere das Passwort jetzt sicher; es wird nicht in Browser-Speichern, Cookies, Logs, Auditdaten oder Operations abgelegt.</p>
            <label asp-for="NewPasswordConfirmation">Passwort bestätigen</label>
            <input asp-for="NewPasswordConfirmation" type="password" autocomplete="new-password" data-password-generator-confirm />
            <span asp-validation-for="NewPasswordConfirmation" class="field-error"></span>
            <label asp-for="SetupSecret">Einrichtungsschlüssel</label>
            <input asp-for="SetupSecret" type="password" autocomplete="off" />
            <span asp-validation-for="SetupSecret" class="field-error"></span>
            <p class="form-help">Verwende den einmaligen Setup-Schlüssel aus der sicheren Runtime-Konfiguration. Er wird nie gespeichert oder protokolliert.</p>
            <p class="form-status" data-password-status role="status" aria-live="polite"></p>
            <button class="primary-button" type="submit">Administrator sicher einrichten</button>
        </form>
    </main>
    <script src="~/admin/admin.js" asp-append-version="true"></script>
</body>
</html>
