@page "/admin/shop"
@model FlurNetz.Api.Pages.Admin.ShopModel
@{ ViewData["Title"] = "Shop"; }
<header class="page-header"><div><div class="eyebrow">Inhalte</div><h1>Shop</h1><p class="muted">Angebote und Lifecycle-Zustände des Owner-Moduls.</p></div></header>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">Katalog</div><h2>Angebote</h2></div><span class="badge">@Model.Items.Count</span></div>@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> } else if (Model.Items.Count == 0) { <div class="empty-state"><strong>Keine Angebote</strong><p>Der Owner-Katalog enthält noch keine Angebote.</p></div> } else { <div class="table-wrap"><table><caption class="visually-hidden">Shop-Angebote</caption><thead><tr><th>Name</th><th>Preis</th><th>Status</th><th>ItemDefinitionId</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.DisplayName</strong><small>@item.Description</small></td><td>@item.Price.Value</td><td><span class="badge @(item.IsArchived ? "neutral" : item.IsEnabled ? "green-badge" : "neutral")">@(item.IsArchived ? "Archiviert" : item.IsEnabled ? "Aktiv" : "Deaktiviert")</span></td><td><code>@item.ItemDefinitionIdValue</code></td></tr> }</tbody></table></div> }</section>
