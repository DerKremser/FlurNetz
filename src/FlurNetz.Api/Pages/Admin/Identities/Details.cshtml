@page "/admin/identities/{communityIdentityId:guid}"
@model FlurNetz.Api.Pages.Admin.Identities.DetailsModel
@{
    ViewData["Title"] = L["Page_IdentityDetail"].Value;
    var identityId = Model.IdentityId.ToString("D");
    string OutcomeLabel(FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome result) => result switch
    {
        FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome.Succeeded => L["Status_Succeeded"].Value,
        FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome.Rejected => L["Status_Rejected"].Value,
        FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome.Failed => L["Status_Failed"].Value,
        _ => L["Status_Unknown"].Value
    };
    string OutcomeClass(FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome result) => result switch
    {
        FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome.Succeeded => "success",
        FlurNetz.Modules.Administration.Contracts.Audit.AdminAuditOutcome.Rejected => "warning",
        _ => "danger"
    };
}
<header class="page-header">
    <div>
        <a class="back-link" href="/admin/identities">← @L["IdentityDetail_Back"]</a>
        <div class="eyebrow">@L["Page_IdentityDetail"]</div>
        <h1>@identityId</h1>
        <p class="muted">@L["IdentityDetail_Description"]</p>
    </div>
    <button class="secondary-button copy-button" type="button" data-copy="@identityId" data-copy-success="@L["IdentityDetail_Copied"]">@L["IdentityDetail_CopyId"]</button>
</header>
<section class="detail-grid">
    <article class="panel detail-hero" aria-labelledby="identity-summary-title">
        <div class="detail-avatar" aria-hidden="true">◎</div>
        <div><div class="eyebrow">@L["IdentityDetail_Central"]</div><h2 id="identity-summary-title">@identityId</h2><p class="muted">@L["IdentityDetail_CentralHelp"]</p></div>
    </article>

    <article class="panel" aria-labelledby="mappings-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Mappings"]</div><h2 id="mappings-title">@L["IdentityDetail_Mappings"]</h2></div><span class="badge neutral">@(Model.MappingsUnavailable ? "–" : Model.Mappings.Count.ToString("N0", CultureInfo.CurrentCulture))</span></div>
        @if (Model.MappingsUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Mappings"]]</div>
        }
        else if (Model.Mappings.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoMappings"]</div>
        }
        else
        {
            foreach (var mapping in Model.Mappings)
            {
                <div class="key-value"><span class="primary-value"><strong>@mapping.ProviderKey.Value</strong><small class="table-subtext">@L["Integrations_ColumnExternalId"]</small></span><code>@mapping.ExternalUserId.Value</code></div>
            }
        }
    </article>

    <article class="panel" aria-labelledby="economy-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Economy"]</div><h2 id="economy-title">@L["IdentityDetail_Balance"]</h2></div><span class="badge success">@L["Status_ReadOnly"]</span></div>
        @if (Model.EconomyUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Economy"]]</div>
        }
        else if (Model.Economy is not null)
        {
            <div class="big-value">@Model.Economy.Balance.Value.ToString("N0", CultureInfo.CurrentCulture)</div><p class="muted">@L["IdentityDetail_BalanceHelp"]</p>
        }
        else
        {
            <div class="empty-inline">@L["IdentityDetail_NoEconomy"]</div>
        }
    </article>

    <article class="panel" aria-labelledby="progression-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Progression"]</div><h2 id="progression-title">@L["IdentityDetail_Experience"]</h2></div><span class="badge purple-badge">@L["Status_ReadOnly"]</span></div>
        @if (Model.ProgressionUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Progression"]]</div>
        }
        else if (Model.Progression is not null)
        {
            <div class="big-value">@Model.Progression.ExperiencePoints.Value.ToString("N0", CultureInfo.CurrentCulture)</div><p class="muted">@L["IdentityDetail_ExperienceHelp"]</p>
        }
        else
        {
            <div class="empty-inline">@L["IdentityDetail_NoProgression"]</div>
        }
    </article>

    <article class="panel" aria-labelledby="inventory-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Inventory"]</div><h2 id="inventory-title">@L["IdentityDetail_Inventory"]</h2></div><span class="badge neutral">@(Model.InventoryUnavailable ? "–" : Model.Inventory.Count.ToString("N0", CultureInfo.CurrentCulture))</span></div>
        @if (Model.InventoryUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Inventory"]]</div>
        }
        else if (Model.Inventory.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoInventory"]</div>
        }
        else
        {
            foreach (var entry in Model.Inventory)
            {
                <div class="key-value"><code>@entry.ItemDefinitionId.Value</code><strong>@entry.Quantity.Value.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
            }
        }
    </article>

    <article class="panel" aria-labelledby="achievements-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Achievements"]</div><h2 id="achievements-title">@L["IdentityDetail_AchievementsUnlocked"]</h2></div><span class="badge neutral">@(Model.AchievementsUnavailable ? "–" : Model.Achievements.Count.ToString("N0", CultureInfo.CurrentCulture))</span></div>
        @if (Model.AchievementsUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Achievements"]]</div>
        }
        else if (Model.Achievements.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoAchievements"]</div>
        }
        else
        {
            foreach (var achievement in Model.Achievements)
            {
                <div class="key-value"><code>@achievement.AchievementDefinitionId.Value</code><small>@achievement.UnlockedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</small></div>
            }
        }
    </article>

    <article class="panel" aria-labelledby="titles-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Titles"]</div><h2 id="titles-title">@L["IdentityDetail_TitlesUnlocked"]</h2></div><span class="badge neutral">@(Model.TitlesUnavailable ? "–" : (Model.Titles?.UnlockedTitleDefinitionIds.Count ?? 0).ToString("N0", CultureInfo.CurrentCulture))</span></div>
        @if (Model.TitlesUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Titles"]]</div>
        }
        else if (Model.Titles is null)
        {
            <div class="empty-inline">@L["IdentityDetail_NoTitlesState"]</div>
        }
        else if (Model.Titles.UnlockedTitleDefinitionIds.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoTitles"]</div>
        }
        else
        {
            foreach (var title in Model.Titles.UnlockedTitleDefinitionIds)
            {
                <div class="key-value"><code>@title.Value</code>@if (Model.Titles.CurrentTitleDefinitionId == title) { <span class="badge success">@L["Status_Current"]</span> }</div>
            }
        }
    </article>

    <article class="panel" aria-labelledby="purchases-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Shop"]</div><h2 id="purchases-title">@L["IdentityDetail_PurchaseHistory"]</h2></div><span class="badge neutral">@(Model.ShopPurchasesUnavailable ? "–" : Model.ShopPurchases.Count.ToString("N0", CultureInfo.CurrentCulture))</span></div>
        @if (Model.ShopPurchasesUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_PurchaseHistory"]]</div>
        }
        else if (Model.ShopPurchases.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoPurchases"]</div>
        }
        else
        {
            foreach (var purchase in Model.ShopPurchases)
            {
                <div class="key-value"><span class="primary-value"><code>@purchase.ItemDefinitionId.Value</code><small class="table-subtext">@purchase.PurchasedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</small></span><strong>@purchase.PricePaid.Value.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
            }
        }
    </article>

    <article class="panel panel-wide" aria-labelledby="notifications-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Notifications"]</div><h2 id="notifications-title">@L["IdentityDetail_Inbox"]</h2></div>@if (!Model.NotificationsUnavailable && Model.UnreadCount is not null) { <span class="badge">@L["IdentityDetail_Unread", Model.UnreadCount.Value.ToString("N0", CultureInfo.CurrentCulture)]</span> }</div>
        @if (Model.NotificationsUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Notifications"]]</div>
        }
        else if (Model.Notifications.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoNotifications"]</div>
        }
        else
        {
            foreach (var notification in Model.Notifications)
            {
                <div class="notification-row"><span class="status-dot @(notification.IsRead ? "muted-dot" : "success")" aria-hidden="true"></span><div><strong>@notification.Title</strong><small>@notification.Message · @notification.CreatedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</small></div><span class="badge @(notification.IsRead ? "neutral" : "success")">@(notification.IsRead ? L["Status_Read"] : L["Status_Unread"])</span></div>
            }
        }
    </article>

    <article class="panel panel-wide" aria-labelledby="admin-history-title">
        <div class="panel-heading"><div><div class="eyebrow">@L["IdentityDetail_Audit"]</div><h2 id="admin-history-title">@L["IdentityDetail_AdminHistory"]</h2></div></div>
        @if (Model.AuditUnavailable)
        {
            <div class="unavailable" role="status">@L["IdentityDetail_Unavailable", L["IdentityDetail_Audit"]]</div>
        }
        else if (Model.AuditEntries.Count == 0)
        {
            <div class="empty-inline">@L["IdentityDetail_NoAudit"]</div>
        }
        else
        {
            foreach (var entry in Model.AuditEntries)
            {
                <div class="audit-row"><span class="status-dot @OutcomeClass(entry.Result)" aria-hidden="true"></span><div><strong>@AdminAuditPresentation.Action(L, entry.Action)</strong><small>@entry.ActorIdentitySnapshot · @entry.OccurredAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</small></div><span class="badge @OutcomeClass(entry.Result)">@OutcomeLabel(entry.Result)</span></div>
            }
        }
    </article>
</section>
